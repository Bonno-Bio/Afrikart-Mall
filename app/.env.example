# Production: a real PostgreSQL server (Supabase, or your own).
# DATABASE_URL=postgres://user:pass@host:5432/postgres

# Local development without a server: a persistent PGlite directory.
PGLITE_DATA_DIR=../.afrikart-db

PORT=4000

# PSP webhook signing secret. Required in production; the handler refuses
# unsigned calls when this is set.
# PSP_WEBHOOK_SECRET=

# SMS gateway for phone-OTP login. Required in production: the process refuses
# to start without it, because a login code that cannot be delivered is a
# customer waiting by a silent phone.
# SMS_PROVIDER=http
# SMS_API_URL=https://your-aggregator.example/send
# SMS_API_KEY=
# SMS_SENDER_ID=Afrikart

# Development convenience only. ALLOW_DEV_AUTH trusts the x-user-id header and
# exposes OTP codes in the response; both are refused in production.
# ALLOW_DEV_AUTH=1
# MIGRATE_ON_BOOT=1
# SEED_ON_BOOT=1
